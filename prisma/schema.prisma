generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}
enum Role {
  ADMIN
  MANAGER
  RECEPTION
  PROFESSIONAL
  FINANCE
  READONLY
}
enum CheckoutMethod {
  card
  pix
}

enum Status {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELED
  NO_SHOW
}
model User {
  id String @id @default(cuid())
  email String @unique
  password String?
  platformAdmin Boolean @default(false)
  emailVerifiedAt DateTime?
  mfaSecret String?
  mfaCounter Int?
  mfaPending String?
  mfaRecoveryIssuedAt DateTime?
  mfaRecoveryHashes String[] @default([])
  socialIdentities SocialIdentity[]
  accountTokens AccountToken[]
  sessions Session[]
  memberships Member[]
  consumerProfiles ConsumerProfile[]
  createdAt DateTime @default(now())
}
model Session {
  tokenHash String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  mfaVerified Boolean @default(false)
  @@index([expiresAt])
}
model Tenant {
  id String @id @default(cuid())
  slug String @unique
  aliases TenantAlias[]
  name String
  description String @default("")
  address String @default("")
  color String @default("#6d42dd")
  coverKey String? @unique
  instagramUrl String?
  contactPhone String?
  policies String @default("")
  theme String @default("light")
  publicDesign Json?
  publicDesignDraft Json?
  media MediaAsset[]
  timezone String @default("America/Sao_Paulo")
  active Boolean @default(false)
  draftBillingCycle String @default("monthly")
  suspended Boolean @default(false)
  stripeCustomerId String? @unique
  billingCheckout BillingCheckout?
  billingSyncAt DateTime?
  billingInvoices BillingInvoice[]
  commercialNotices CommercialNotice[]
  stripeAccountId String? @unique
  connectAttemptAt DateTime?
  connectAttemptEmail String?
  connectAttemptScope String?
  connectPausedAt DateTime?
  onlinePayment Boolean @default(false)
  pixCheckoutEnabled Boolean @default(false)
  depositPercent Int @default(100)
  platformFeeBps Int?
  platformFeeFixed Int?
  whatsappInstance String? @unique
  merchantNoticePhone String?
  reminderTemplate String?
  statusMessages Boolean @default(false)
  reminderPresets Int[] @default([])
  whatsappTemplates Json?
  birthdayMessages Boolean @default(false)
  returnAfterDays Int?
  completionMessages Boolean @default(false)
  reviewUrl String?
  reminderMinutes Int?
  members Member[]
  teamInvites TeamInvite[]
  teamEvents TeamEvent[]
  services Service[]
  professionals Professional[]
  customers Customer[]
  consumerProfiles ConsumerProfile[]
  consumerNoticeHours Int?
  automaticAppointmentRefunds Boolean @default(false)
  suppliers Supplier[]
  offers CommercialOffer[]
  automationRules AutomationRule[]
  products Product[]
  catalogCategories CatalogCategory[]
  financialEntries FinancialEntry[]
  orders ShopOrder[]
  campaigns Campaign[]
  holidays StoreHoliday[]
  loyaltyEnabled Boolean @default(false)
  appointments Appointment[]
  subscriptions Subscription[]
  createdAt DateTime @default(now())
}
model Member {
  tenantId String
  userId String
  role Role
  disabledAt DateTime?
  permissions String[] @default([])
  permissionsCustomized Boolean @default(false)
  professionalId String?
  professional Professional? @relation(fields: [tenantId, professionalId], references: [tenantId, id])
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@id([tenantId, userId])
  @@unique([tenantId, professionalId])
  @@index([userId])
}
model Service {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id])
  name String
  description String @default("")
  category String @default("")
  archivedAt DateTime?
  cents Int
  duration Int
  active Boolean @default(true)
  assignments Assignment[]
  appointments Appointment[]
  waitlist WaitEntry[]
  @@unique([tenantId, id])
}
model Professional {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id])
  name String
  active Boolean @default(true)
  commissionBps Int @default(0)
  commissionFixed Int @default(0)
  assignments Assignment[]
  hours WorkHours[]
  blocks ScheduleBlock[]
  teamMembers Member[]
  teamInvites TeamInvite[]
  waitlist WaitEntry[]
  appointments Appointment[]
  @@unique([tenantId, id])
}
model Assignment {
  tenantId String
  professionalId String
  serviceId String
  professional Professional @relation(fields: [tenantId, professionalId], references: [tenantId, id])
  service Service @relation(fields: [tenantId, serviceId], references: [tenantId, id])
  @@id([tenantId, professionalId, serviceId])
}
model WorkHours {
  id String @id @default(cuid())
  tenantId String
  professionalId String
  professional Professional @relation(fields: [tenantId, professionalId], references: [tenantId, id])
  weekday Int
  startMinute Int
  endMinute Int
  @@unique([tenantId, professionalId, weekday, startMinute])
}
model Customer {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id])
  name String
  phone String
  birthMonthDay String?
  followupConsentAt DateTime?
  appointments Appointment[]
  @@unique([tenantId, id])
  @@unique([tenantId, phone])
  @@index([birthMonthDay])
}
model Product {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id])
  name String
  category String @default("")
  description String @default("")
  sku String?
  barcode String?
  published Boolean @default(true)
  archivedAt DateTime?
  variantOfId String?
  variantOf Product? @relation("ProductVariants", fields: [tenantId, variantOfId], references: [tenantId, id], onDelete: Restrict)
  variants Product[] @relation("ProductVariants")
  cents Int
  costCents Int @default(0)
  promotionCents Int?
  minimumStock Int @default(0)
  stock Int
  movements StockMovement[]
  orderItems ShopOrderItem[]
  purchases Purchase[]
  offers CommercialOffer[]
  @@index([tenantId])
  @@index([tenantId, variantOfId])
  @@unique([tenantId, id])
  @@unique([tenantId, sku])
}

model CatalogCategory {
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name String
  @@id([tenantId, name])
}

enum MovementKind {
  ADJUSTMENT
  SALE
  REVERSAL
}

model StockMovement {
  id String @id @default(cuid())
  tenantId String
  productId String
  product Product @relation(fields: [tenantId, productId], references: [tenantId, id])
  kind MovementKind
  quantity Int
  unitCents Int @default(0)
  unitCostCents Int @default(0)
  requestId String
  reversedAt DateTime?
  createdAt DateTime @default(now())
  @@unique([tenantId, requestId])
  @@index([tenantId, createdAt])
}

enum EntryKind {
  INCOME
  EXPENSE
}

model FinancialEntry {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id])
  kind EntryKind
  classification String @default("GENERAL")
  title String
  cents Int
  dueAt DateTime
  paidAt DateTime?
  purchase Purchase?
  createdAt DateTime @default(now())
  @@unique([tenantId, id])
  @@index([tenantId, dueAt])
  @@index([tenantId, paidAt])
}

model Appointment {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id])
  serviceId String
  professionalId String
  customerId String
  consumerUserId String?
  consumer ConsumerProfile? @relation(fields: [tenantId, consumerUserId], references: [tenantId, userId], onDelete: Restrict)
  service Service @relation(fields: [tenantId, serviceId], references: [tenantId, id])
  professional Professional @relation(fields: [tenantId, professionalId], references: [tenantId, id])
  customer Customer @relation(fields: [tenantId, customerId], references: [tenantId, id])
  startsAt DateTime @db.Timestamptz(3)
  endsAt DateTime @db.Timestamptz(3)
  status Status
  cents Int
  paidAt DateTime?
  chargeCents Int?
  platformFeeCents Int @default(0)
  commission ProfessionalCommission?
  checkoutMethod CheckoutMethod @default(card)
  paymentIntentId String? @unique
  refundedAt DateTime?
  consent Boolean @default(false)
  checkoutId String? @unique
  expiresAt DateTime?
  checkoutReturnUrl String?
  checkoutAccountId String?
  checkoutState String?
  paymentToken String? @unique
  automationRuns AutomationRun[]
  reminders Reminder[]
  history AppointmentHistory[]
  refundRequest AppointmentRefundRequest?
  connectedRefunds ConnectedRefund[]
  createdAt DateTime @default(now())
  @@unique([tenantId, id])
  @@index([tenantId, startsAt])
  @@index([tenantId, consumerUserId, startsAt])
}
model Plan {
  id String @id @default(cuid())
  name String
  description String
  trialDays Int @default(0)
  platformFeeBps Int @default(0)
  platformFeeFixed Int @default(0)
  monthlyCents Int
  annualCents Int
  monthlyPriceId String @unique
  annualPriceId String @unique
  active Boolean @default(true)
  subscriptions Subscription[]
  priceHistory PlanPriceHistory[]
}
model Subscription {
  id String @id
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id])
  planId String
  plan Plan @relation(fields: [planId], references: [id])
  status String
  recurringCents Int?
  recurringInterval String?
  updatedAt DateTime @updatedAt
  @@index([tenantId, status])
}
model WebhookEvent {
  id String @id
  type String
  source String?
  createdAt DateTime @default(now())
}
model Reminder {
  id String @id @default(cuid())
  appointmentId String
  appointment Appointment @relation(fields: [appointmentId], references: [id])
  runAt DateTime
  kind String @default("REMINDER")
  scheduledStart DateTime?
  sentAt DateTime?
  claimedAt DateTime?
  deliveryState String @default("QUEUED")
  deliveryAttempts Int @default(0)
  retryAt DateTime?
  providerMessageId String?
  recipientPhone String?
  dedupeKey String? @unique
  automationRuns AutomationRun[]
  @@unique([appointmentId, runAt, kind])
  @@index([sentAt, runAt])
}

enum TokenPurpose {
  PASSWORD_RESET
  EMAIL_VERIFY
}

model AccountToken {
  tokenHash String @id
  purpose TokenPurpose
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  @@unique([userId, purpose])
  @@index([expiresAt])
}

model RateLimit {
  key String @id
  count Int
  expiresAt DateTime
  @@index([expiresAt])
}

model AdminAudit {
  id String @id @default(cuid())
  actorId String
  action String
  targetId String
  createdAt DateTime @default(now())
  @@index([createdAt])
}

model BillingCheckout {
  id String @id @default(cuid())
  tenantId String @unique
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  priceId String
  customerId String
  trialDays Int
  expiresAt DateTime
}

model StripeSettings {
  id Int @id
  accountId String
  publishableKey String
  mode String
  encrypted String
  previousWebhooks String?
  previousWebhooksUntil DateTime?
  paused Boolean @default(false)
  checkedAt DateTime?
  checkSucceeded Boolean?
  paymentsEnabled Boolean?
  payoutsEnabled Boolean?
  updatedAt DateTime @updatedAt
}

model ScheduleBlock {
  id String @id @default(cuid())
  tenantId String
  professionalId String
  professional Professional @relation(fields: [tenantId, professionalId], references: [tenantId, id])
  startsAt DateTime @db.Timestamptz(3)
  endsAt DateTime @db.Timestamptz(3)
  reason String
  @@index([tenantId, professionalId, startsAt])
}

model AppointmentHistory {
  id String @id @default(cuid())
  appointmentId String
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  actorId String?
  operation String
  previousStart DateTime?
  newStart DateTime?
  createdAt DateTime @default(now())
  @@index([appointmentId, createdAt])
}

model WaitEntry {
  id String @id @default(cuid())
  tenantId String
  serviceId String
  professionalId String
  professional Professional @relation(fields: [tenantId, professionalId], references: [tenantId, id])
  service Service @relation(fields: [tenantId, serviceId], references: [tenantId, id])
  day String
  name String
  phone String
  closedAt DateTime?
  notificationConsentAt DateTime?
  notificationState String @default("QUEUED")
  notificationCheckedAt DateTime?
  notificationReference String?
  createdAt DateTime @default(now())
  @@unique([tenantId, professionalId, serviceId, day, phone])
  @@index([tenantId, day])
  @@index([notificationState, day, notificationCheckedAt])
}

enum MediaKind {
  LOGO
  BANNER
  COVER
  PROFESSIONAL
  SERVICE
  PRODUCT
  GALLERY
  PROFILE
}

model MediaAsset {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind MediaKind
  target String
  key String @unique
  bytes Int
  position Int?
  createdAt DateTime @default(now())
  @@unique([tenantId, kind, target])
}

enum OrderStatus {
  PENDING
  PAID
  CANCELED
  REFUNDED
}

model ShopOrder {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id])
  offerId String?
  offerSelection String?
  offer CommercialOffer? @relation(fields: [tenantId, offerId], references: [tenantId, id], onDelete: Restrict)
  requestId String
  customerName String
  phone String
  consumerUserId String?
  consumer ConsumerProfile? @relation(fields: [tenantId, consumerUserId], references: [tenantId, userId], onDelete: Restrict)
  cents Int
  platformFeeCents Int @default(0)
  status OrderStatus @default(PENDING)
  paymentReview Boolean @default(false)
  checkoutId String? @unique
  checkoutMethod CheckoutMethod @default(card)
  paymentIntentId String? @unique
  expiresAt DateTime
  paidAt DateTime?
  refundedAt DateTime?
  recognizedSale Boolean?
  stockReturnedAt DateTime?
  createdAt DateTime @default(now())
  items ShopOrderItem[]
  connectedRefunds ConnectedRefund[]
  @@index([tenantId, stockReturnedAt])
  @@unique([tenantId, requestId])
  @@unique([tenantId, id])
  @@index([status, expiresAt])
  @@index([tenantId, consumerUserId, createdAt])
}

model ShopOrderItem {
  tenantId String
  orderId String
  productId String
  quantity Int
  name String
  unitCents Int
  unitCostCents Int?
  discountCents Int @default(0)
  order ShopOrder @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade)
  product Product @relation(fields: [tenantId, productId], references: [tenantId, id])
  @@id([orderId, productId])
}

model BillingInvoice {
  id String @id
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  status String
  currency String
  amountDue Int
  amountPaid Int
  hostedUrl String?
  issuedAt DateTime
  updatedAt DateTime @updatedAt
  @@index([tenantId, issuedAt])
}

model TeamInvite {
  tokenHash String @id
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email String
  role Role
  professionalId String?
  professional Professional? @relation(fields: [tenantId, professionalId], references: [tenantId, id])
  expiresAt DateTime
  @@unique([tenantId, email])
}

model TeamEvent {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorId String
  subject String
  action String
  createdAt DateTime @default(now())
  @@index([tenantId, createdAt])
}

model ProfessionalCommission {
  appointmentId String @id
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  cents Int
  paidAt DateTime?
  paymentReference String?
  createdAt DateTime @default(now())
}

model CommercialRule {
  kind String @id
  enabled Boolean @default(false)
  hour Int
  leadDays Int
  template String
}

model CommercialNotice {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind String
  reference String
  invoiceId String?
  subscriptionId String?
  sendAt DateTime
  state String @default("QUEUED")
  claimedAt DateTime?
  attempts Int @default(0)
  planName String?
  cents Int?
  dueAt DateTime?
  @@unique([tenantId, kind, reference])
  @@index([state, sendAt])
}

model EvolutionSetting {
  id Int @id
  endpoint String
  encryptedKey String
  qrEnabled Boolean @default(false)
  checkedAt DateTime
}

model WorkerHeartbeat {
  id Int @id
  seenAt DateTime
}

model StripeMovement {
  id String @id @default(cuid())
  scope String
  stripeId String
  sourceId String?
  customerId String?
  intentId String?
  category String
  status String
  gross Int
  fee Int
  net Int
  currency String
  occurredAt DateTime
  recordedAt DateTime @default(now())
  @@index([scope, stripeId, recordedAt])
  @@index([scope, occurredAt])
}

model TenantAlias {
  slug String @id
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([tenantId])
}

model SocialIdentity {
  provider String
  subject String
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@id([provider, subject])
  @@unique([userId, provider])
}

model SocialProviderSettings {
  provider String @id
  encrypted String
  enabled Boolean @default(false)
  revision String
}

model SocialAttempt {
  stateHash String @id
  browserHash String
  provider String
  encrypted String
  expiresAt DateTime
  @@index([expiresAt])
}

model ConsumerProfile {
  tenantId String
  userId String
  name String
  phone String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  orders ShopOrder[]
  marketingEmail String?
  marketingEmailAt DateTime?
  marketingPhone String?
  marketingPhoneAt DateTime?
  marketingPhoneCode String?
  marketingPhoneCodeUntil DateTime?
  deliveries CampaignDelivery[]
  loyaltyRewards LoyaltyReward[]

  @@id([tenantId, userId])
  @@index([userId])
}

model PlanPriceHistory {
  priceId String @id
  planId String
  plan Plan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([planId])
}

model AppointmentRefundRequest {
  appointmentId String @id
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  accountId String
  paymentIntentId String
  amount Int
  includeFee Boolean
  createdAt DateTime @default(now())
  retryAt DateTime @default(now())
  stripeRefundId String? @unique
  state String @default("QUEUED")

  @@index([state, retryAt])
}

model ConnectedRefund {
  id String
  accountId String
  appointmentId String?
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  orderId String?
  order ShopOrder? @relation(fields: [orderId], references: [id], onDelete: Restrict)
  amount Int
  state String
  succeededAt DateTime?

  @@id([accountId, id])
  @@index([appointmentId, succeededAt])
  @@index([orderId, succeededAt])
}

model MailSetting {
  id Int @id
  sender String
  encryptedKey String
  updatedAt DateTime @updatedAt
}

model AutomationRule {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name String
  trigger String
  graph Json
  enabled Boolean @default(false)
  revision Int @default(1)
  updatedAt DateTime @updatedAt
  runs AutomationRun[]
  @@unique([tenantId, id])
  @@index([tenantId, enabled, trigger])
}

model AutomationRun {
  id String @id @default(cuid())
  tenantId String
  ruleId String
  revision Int
  appointmentId String
  startsAt DateTime
  trigger String
  createdAt DateTime @default(now())
  state String @default("QUEUED")
  reminderId String?
  reminder Reminder? @relation(fields: [reminderId], references: [id], onDelete: SetNull)
  rule AutomationRule @relation(fields: [tenantId, ruleId], references: [tenantId, id], onDelete: Restrict)
  appointment Appointment @relation(fields: [tenantId, appointmentId], references: [tenantId, id], onDelete: Cascade)
  @@unique([ruleId, revision, appointmentId, startsAt, trigger])
  @@index([state, createdAt])
  @@index([tenantId, createdAt])
  @@index([reminderId])
}

model Supplier {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name String
  contact String @default("")
  createdAt DateTime @default(now())
  purchases Purchase[]
  @@unique([tenantId, id])
  @@unique([tenantId, name])
}

model Purchase {
  id String @id @default(cuid())
  tenantId String
  supplierId String
  productId String
  quantity Int
  unitCostCents Int
  requestId String
  reference String
  receivedAt DateTime @default(now())
  supplier Supplier @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Restrict)
  product Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  expenseId String @unique
  expense FinancialEntry @relation(fields: [tenantId, expenseId], references: [tenantId, id], onDelete: Restrict)
  @@unique([tenantId, requestId])
  @@unique([tenantId, expenseId])
  @@index([tenantId, receivedAt])
}

model CommercialOffer {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind String
  name String
  code String?
  bps Int
  startsAt DateTime
  endsAt DateTime
  enabled Boolean @default(true)
  productId String?
  product Product? @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  items Json?
  orders ShopOrder[]
  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, kind, enabled, startsAt, endsAt])
}

model StoreHoliday {
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  date String
  name String
  @@id([tenantId, date])
}

model Campaign {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channel String
  title String
  body String
  createdAt DateTime @default(now())
  deliveries CampaignDelivery[]
  @@unique([tenantId, id])
  @@index([tenantId, createdAt])
}

model CampaignDelivery {
  id String @id @default(cuid())
  tenantId String
  campaignId String
  userId String
  campaign Campaign @relation(fields: [tenantId, campaignId], references: [tenantId, id], onDelete: Cascade)
  consumer ConsumerProfile @relation(fields: [tenantId, userId], references: [tenantId, userId], onDelete: Cascade)
  state String @default("QUEUED")
  createdAt DateTime @default(now())
  claimedAt DateTime?
  @@unique([campaignId, userId])
  @@index([state, createdAt])
}

model LoyaltyReward {
  tenantId String
  userId String
  sequence Int
  redeemedAt DateTime @default(now())
  consumer ConsumerProfile @relation(fields: [tenantId, userId], references: [tenantId, userId], onDelete: Cascade)
  @@id([tenantId, userId, sequence])
}

model MediaCleanup {
  key String @id
  attempts Int @default(0)
  nextAt DateTime @default(now())
  @@index([nextAt])
}
