generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}
enum Role {
  ADMIN
  MANAGER
  RECEPTION
  PROFESSIONAL
}
enum Status {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELED
}
model User {
  id String @id @default(cuid())
  email String @unique
  password String
  platformAdmin Boolean @default(false)
  sessions Session[]
  memberships Member[]
  createdAt DateTime @default(now())
}
model Session {
  tokenHash String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  @@index([expiresAt])
}
model Tenant {
  id String @id @default(cuid())
  slug String @unique
  name String
  description String @default("")
  address String @default("")
  color String @default("#6d42dd")
  coverKey String? @unique
  timezone String @default("America/Sao_Paulo")
  active Boolean @default(false)
  suspended Boolean @default(false)
  stripeCustomerId String? @unique
  stripeAccountId String? @unique
  onlinePayment Boolean @default(false)
  whatsappInstance String? @unique
  reminderMinutes Int?
  members Member[]
  services Service[]
  professionals Professional[]
  customers Customer[]
  products Product[]
  appointments Appointment[]
  subscriptions Subscription[]
  createdAt DateTime @default(now())
}
model Member {
  tenantId String
  userId String
  role Role
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@id([tenantId, userId])
  @@index([userId])
}
model Service {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id])
  name String
  description String @default("")
  cents Int
  duration Int
  active Boolean @default(true)
  assignments Assignment[]
  appointments Appointment[]
  @@unique([tenantId, id])
}
model Professional {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id])
  name String
  active Boolean @default(true)
  assignments Assignment[]
  hours WorkHours[]
  appointments Appointment[]
  @@unique([tenantId, id])
}
model Assignment {
  tenantId String
  professionalId String
  serviceId String
  professional Professional @relation(fields: [tenantId, professionalId], references: [tenantId, id])
  service Service @relation(fields: [tenantId, serviceId], references: [tenantId, id])
  @@id([tenantId, professionalId, serviceId])
}
model WorkHours {
  id String @id @default(cuid())
  tenantId String
  professionalId String
  professional Professional @relation(fields: [tenantId, professionalId], references: [tenantId, id])
  weekday Int
  startMinute Int
  endMinute Int
  @@unique([tenantId, professionalId, weekday, startMinute])
}
model Customer {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id])
  name String
  phone String
  appointments Appointment[]
  @@unique([tenantId, id])
  @@unique([tenantId, phone])
}
model Product {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id])
  name String
  cents Int
  stock Int
  @@index([tenantId])
}
model Appointment {
  id String @id @default(cuid())
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id])
  serviceId String
  professionalId String
  customerId String
  service Service @relation(fields: [tenantId, serviceId], references: [tenantId, id])
  professional Professional @relation(fields: [tenantId, professionalId], references: [tenantId, id])
  customer Customer @relation(fields: [tenantId, customerId], references: [tenantId, id])
  startsAt DateTime @db.Timestamptz(3)
  endsAt DateTime @db.Timestamptz(3)
  status Status
  cents Int
  paidAt DateTime?
  consent Boolean @default(false)
  checkoutId String? @unique
  expiresAt DateTime?
  reminders Reminder[]
  createdAt DateTime @default(now())
  @@index([tenantId, startsAt])
}
model Plan {
  id String @id @default(cuid())
  name String
  description String
  monthlyCents Int
  annualCents Int
  monthlyPriceId String @unique
  annualPriceId String @unique
  active Boolean @default(true)
  subscriptions Subscription[]
}
model Subscription {
  id String @id
  tenantId String
  tenant Tenant @relation(fields: [tenantId], references: [id])
  planId String
  plan Plan @relation(fields: [planId], references: [id])
  status String
  updatedAt DateTime @updatedAt
  @@index([tenantId, status])
}
model WebhookEvent {
  id String @id
  type String
  createdAt DateTime @default(now())
}
model Reminder {
  id String @id @default(cuid())
  appointmentId String
  appointment Appointment @relation(fields: [appointmentId], references: [id])
  runAt DateTime
  sentAt DateTime?
  claimedAt DateTime?
  @@unique([appointmentId, runAt])
  @@index([sentAt, runAt])
}
